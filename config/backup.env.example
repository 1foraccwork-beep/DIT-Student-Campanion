# Copy to config/backup.env and chmod 600. Do not commit backup.env.
# Prefer injecting these values through your production secret manager.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
BACKUP_ENCRYPTION_PASSPHRASE_FILE="/etc/dit-student-companion/backup-passphrase"
BACKUP_DIR="/var/backups/dit-student-companion"
BACKUP_RETENTION_DAYS="14"
BACKUP_PREFIX="dit-student-companion"
